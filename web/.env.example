# Leave NEXT_PUBLIC_API_URL empty to run the self-contained demo mode (sample data in the browser).
# Set it to the FastAPI URL to use the real backend, e.g. https://api.your-domain.ae
NEXT_PUBLIC_API_URL=
# Public URL of this site (canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only when hosting under a sub-path (GitHub Pages project sites), e.g. /uae-autoparts-hub
NEXT_PUBLIC_BASE_PATH=
