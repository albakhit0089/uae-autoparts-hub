# Copy to api/.env — never commit real secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autoparts   # or Supabase: postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
JWT_SECRET=generate-a-long-random-string                                # python -c "import secrets;print(secrets.token_urlsafe(48))"
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Optional — WhatsApp Business Platform (Cloud API) for supplier notifications (templates must be approved by Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional — Claude-powered query extraction (falls back to the rule-based parser when unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
